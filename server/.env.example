# TedBus server configuration.
# Copy this file to server/.env, fill in real values, then start the server.
# server/.env is git-ignored and must NEVER be committed.
#
# The server loads server/.env automatically (dotenv) on startup and on every
# script under server/scripts/. The values below are read at startup:
#   - server/index.js and server/debug-server.js   (server entry points)
#   - server/scripts/seed-admin.js                 (admin account seed)
#   - server/scripts/dedupe-customers.js           (dedupe utility)

# --- MongoDB (REQUIRED) ------------------------------------------------
# Atlas (or local) connection string. Canonical DB variable used by
# index.js, debug-server.js, scripts/seed-admin.js and
# scripts/dedupe-customers.js. No value = server exits with a message.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=tedbus

# --- JWT signing secrets (REQUIRED) ------------------------------------
# JWT_SECRET:            customer session tokens — middleware/auth.js, also
#                        used as TICKET_SIGNING_SECRET fallback
# ADMIN_JWT_SECRET:      admin panel tokens — middleware/adminAuth.js
# TICKET_SIGNING_SECRET: ticket QR HMAC — utils/bookingRef.js (falls back to
#                        JWT_SECRET). A distinct value is recommended.
JWT_SECRET=
ADMIN_JWT_SECRET=
TICKET_SIGNING_SECRET=

# --- Admin seed (scripts/seed-admin.js) --------------------------------
# Only used when running `node scripts/seed-admin.js`. Required by that
# script; it exits with a message if either is missing.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# --- Email (SMTP) ------------------------------------------------------
# Used by services/ticketMailer.js (booking ticket emails) and
# services/notificationService.js (notification emails).
#
# Gmail setup:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use that 16-char App Password as SMTP_PASS (NOT your regular password).
#
# When unset, ticket emails are silently skipped (booking still succeeds).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TedBus <no-reply@tedbus.local>

# --- Web Push (VAPID) --------------------------------------------------
# If unset, the server generates + persists a stable key pair in
# server/.vapid-keys.json on first boot and serves the public key via
# GET /notifications/push-public-key. Set these only if you want to manage
# the keys yourself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@tedbus.local

# --- Google OAuth (Email+OTP alternative login) -------------------------
# GOOGLE_CLIENT_ID: OAuth 2.0 client ID from Google Cloud Console.
# Used by the /auth/google-login endpoint to verify Google ID tokens
# server-side. Create credentials at:
#   https://console.cloud.google.com/apis/credentials
# Enable "Google+ API" or "Google Identity Platform" for ID token verification.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Google Maps Platform (Route Planner) -------------------------------
# GOOGLE_MAPS_API_KEY: Server-side key for the Google Routes API (traffic-
# aware routing, alternative routes). Restrict this key by IP in the Google
# Cloud Console. A separate browser-restricted key for the Maps JavaScript
# API is configured in src/app/config/index.ts.
GOOGLE_MAPS_API_KEY=

# --- Runtime -----------------------------------------------------------
# NODE_ENV=test skips the journey-reminder scheduler (index.js:86).
# The port used by server/index.js (default 5000) and server/debug-server.js
# (default 5050) — both read PORT.
NODE_ENV=development
PORT=5000
